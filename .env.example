# ============================================================================
# LexCausa environment template
# Copy this file to .env and fill in real values.
# ============================================================================

# ----------------------------------------------------------------------------
# Core app configuration
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ----------------------------------------------------------------------------
# LLM backend selector:  groq (default) | local (vLLM/Ibisco) | openrouter
# Tip: prefer choosing it per-command so you can switch freely, e.g.
#   LLM_BACKEND=openrouter poetry run python -m src.api_server
# rather than pinning it here.
# ----------------------------------------------------------------------------
# LLM_BACKEND=groq

# ----------------------------------------------------------------------------
# Groq Cloud  (LLM_BACKEND=groq)  — key rotation via GROQ_API_KEY_V1..N
# ----------------------------------------------------------------------------
GROQ_API_KEY_V1=your_groq_api_key_here
GROQ_API_KEY_V2=
GROQ_API_KEY_V3=

# ----------------------------------------------------------------------------
# OpenRouter  (LLM_BACKEND=openrouter)  — paid, OpenAI-compatible, provider-pinned
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_key_here
# Fixed aux model (retrieval filters / classifier / evaluator). Alias or raw slug.
OPENROUTER_AUX_MODEL=llama_4_scout
# Defaults below are fine; override only if needed:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_PROVIDER_ONLY=["alibaba"]     # JSON list; empty [] = any provider
# OPENROUTER_ALLOW_FALLBACKS=false

# ----------------------------------------------------------------------------
# vLLM offline / Ibisco HPC  (LLM_BACKEND=local)  — GPU/serving overrides
# (vLLM defaults apply if unset)
# ----------------------------------------------------------------------------
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_MAX_MODEL_LEN=
# VLLM_HF_CACHE_DIR=
# VLLM_QUANTIZATION=
