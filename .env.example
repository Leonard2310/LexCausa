# ============================================================================
# LexCausa environment template
# Copy this file to .env and fill in real values.
# ============================================================================

# ----------------------------------------------------------------------------
# Core app configuration
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Groq Cloud API keys (rotation supported by src/config.py)
GROQ_API_KEY_V1=your_groq_api_key_here
GROQ_API_KEY_V2=
GROQ_API_KEY_V3=

# API server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ----------------------------------------------------------------------------
# Notebook benchmark (Groq vs SCOPE)
# notebooks/scope_hpc_feasibility_tests.ipynb
# ----------------------------------------------------------------------------
# Groq OpenAI-compatible benchmark key (notebook)
GROQ_API_KEY=your_groq_api_key_for_notebook

# SCOPE OpenAI-compatible benchmark settings (notebook)
SCOPE_API_KEY=your_scope_api_key
SCOPE_ENDPOINT=https://your-scope-endpoint/v1/chat/completions

# Optional extra headers as JSON object string.
# Use {} if not required.
SCOPE_EXTRA_HEADERS_JSON={}

# Optional notebook HPC overrides
SCOPE_HPC_USER=<USERNAME>
SCOPE_HPC_HOST=<HPC_HOST>
SCOPE_HPC_REMOTE_WORKDIR=/ibiscostorage/<USERNAME>/lexcausa_bench
